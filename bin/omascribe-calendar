#!/usr/bin/env python3
"""OAuth and Google Calendar helper for OmaScribe."""

from __future__ import annotations

import argparse
import base64
import calendar as month_calendar
import hashlib
import http.client
import http.server
import ipaddress
import json
import os
import re
import secrets
import subprocess
import socket
import ssl
import sys
import urllib.parse
import urllib.request
import webbrowser
import time as time_module
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import date, datetime, time, timedelta
from pathlib import Path
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError

APP = "omascribe-calendar"
LEGACY_KEYRING_APP = "omarchy-calendar"
SCOPE = "openid email https://www.googleapis.com/auth/calendar.readonly"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / APP
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / APP
CLIENT_FILE = CONFIG / "client_secret.json"
ACCOUNTS_FILE = STATE / "accounts.json"
PREFERENCES_FILE = STATE / "preferences.json"
FEEDS_FILE = STATE / "feeds.json"
CACHE_DIR = STATE / "agenda-cache"
CACHE_TTL_SECONDS = 300
URL_RE = re.compile(r"https://(?:meet\.google\.com|(?:[\w-]+\.)*zoom\.us|teams\.microsoft\.com|(?:[\w-]+\.)*webex\.com)/[^\s<>\"]+", re.I)
PRIORITIES = ("family", "work", "normal", "informational")


def resolve_public_https_url(url: str) -> tuple[urllib.parse.ParseResult, tuple[str, ...]]:
    """Validate an HTTPS URL and return the public addresses it may use."""
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
        raise ValueError("calendar subscriptions must use a public https URL")
    try:
        addresses = sorted({item[4][0] for item in socket.getaddrinfo(
            parsed.hostname, parsed.port or 443, type=socket.SOCK_STREAM)})
    except socket.gaierror as exc:
        raise ValueError("calendar subscription host could not be resolved") from exc
    for value in addresses:
        address = ipaddress.ip_address(value)
        if (address.is_private or address.is_loopback or address.is_link_local
                or address.is_reserved or address.is_multicast or address.is_unspecified):
            raise ValueError("calendar subscriptions cannot use private or local hosts")
    if not addresses:
        raise ValueError("calendar subscription host could not be resolved")
    return parsed, tuple(addresses)


def validate_remote_calendar_url(url: str) -> urllib.parse.ParseResult:
    """Compatibility wrapper for callers that need URL validation only."""
    return resolve_public_https_url(url)[0]


class PinnedHTTPSConnection(http.client.HTTPSConnection):
    """Connect to a validated IP while verifying TLS for the original host."""

    def __init__(self, host: str, port: int, pinned_ip: str, *, timeout: int = 20):
        super().__init__(host, port=port, timeout=timeout,
                         context=ssl.create_default_context())
        self.pinned_ip = pinned_ip

    def connect(self) -> None:
        self.sock = socket.create_connection(
            (self.pinned_ip, self.port), self.timeout, self.source_address)
        self.sock = self._context.wrap_socket(self.sock, server_hostname=self.host)


def fetch_public_https(url: str, headers: dict[str, str], *, max_redirects: int = 5) -> bytes:
    """Fetch from the exact public address validated for each HTTPS hop."""
    original = urllib.parse.urlparse(url)
    current = url
    for redirect_count in range(max_redirects + 1):
        parsed, addresses = resolve_public_https_url(current)
        if (parsed.scheme, parsed.hostname, parsed.port or 443) != (
                original.scheme, original.hostname, original.port or 443):
            raise ValueError("calendar feed redirect changed origin")
        connection = PinnedHTTPSConnection(
            parsed.hostname, parsed.port or 443, addresses[0], timeout=20)
        path = urllib.parse.urlunsplit(("", "", parsed.path or "/", parsed.query, ""))
        try:
            connection.request("GET", path, headers=headers)
            response = connection.getresponse()
            if response.status in (301, 302, 303, 307, 308):
                location = response.getheader("Location")
                if not location or redirect_count >= max_redirects:
                    raise ValueError("calendar feed redirect limit exceeded")
                current = urllib.parse.urljoin(current, location)
                continue
            if response.status < 200 or response.status >= 300:
                raise ValueError(f"calendar feed returned HTTP {response.status}")
            data = response.read(10 * 1024 * 1024 + 1)
            if len(data) > 10 * 1024 * 1024:
                raise ValueError("iCalendar feed exceeds 10 MB")
            return data
        finally:
            connection.close()
    raise ValueError("calendar feed redirect limit exceeded")


def atomic_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)


def feeds() -> list[dict]:
    try:
        value = json.loads(FEEDS_FILE.read_text()).get("feeds", [])
        return value if isinstance(value, list) else []
    except (OSError, json.JSONDecodeError):
        return []


def save_feeds(items: list[dict]) -> None:
    atomic_json(FEEDS_FILE, {"feeds": items})
    invalidate_cache()


def add_feed(source: str, name: str | None = None) -> dict:
    source = source.strip()
    if source.startswith("webcal://"):
        source = "https://" + source[len("webcal://"):]
    parsed = urllib.parse.urlparse(source)
    if parsed.scheme not in ("http", "https", "file"):
        path = Path(source).expanduser().resolve()
        if not path.is_file():
            raise ValueError("iCalendar source must be an https URL or readable .ics file")
        source = path.as_uri()
    elif parsed.scheme == "file":
        raise ValueError("use a local .ics path instead of a file URL")
    elif parsed.scheme == "http":
        raise ValueError("calendar subscriptions must use https")
    elif parsed.scheme == "https":
        validate_remote_calendar_url(source)
    feed_id = hashlib.sha256(source.encode()).hexdigest()[:16]
    item = {"id": feed_id, "name": (name or "Calendar").strip() or "Calendar",
            "source": source, "enabled": True, "priority": "normal"}
    # Validate before saving so a typo never leaves a broken source behind.
    read_ical_source(item)
    items = [old for old in feeds() if old.get("id") != feed_id]
    items.append(item)
    save_feeds(items)
    return item


def remove_feed(feed_id: str) -> None:
    items = [item for item in feeds() if item.get("id") != feed_id]
    if len(items) == len(feeds()):
        raise ValueError(f"unknown iCalendar source: {feed_id}")
    save_feeds(items)


def read_ical_source(feed: dict) -> str:
    source = str(feed.get("source", ""))
    parsed = urllib.parse.urlparse(source)
    if parsed.scheme == "file":
        path = Path(urllib.request.url2pathname(parsed.path))
        data = path.read_bytes()
    else:
        data = fetch_public_https(source, {
            "Accept": "text/calendar, text/plain;q=0.9, */*;q=0.1",
            "User-Agent": "OmaScribe/0.5",
        })
    text = data.decode("utf-8-sig", errors="replace")
    if "BEGIN:VCALENDAR" not in text.upper():
        raise ValueError("source is not an iCalendar feed")
    return text


def unfold_ical(text: str) -> list[str]:
    lines = text.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    unfolded: list[str] = []
    for line in lines:
        if line.startswith((" ", "\t")) and unfolded:
            unfolded[-1] += line[1:]
        else:
            unfolded.append(line)
    return unfolded


def unescape_ical(value: str) -> str:
    return (value.replace("\\N", "\n").replace("\\n", "\n")
            .replace("\\,", ",").replace("\\;", ";").replace("\\\\", "\\"))


def parse_content_line(line: str) -> tuple[str, dict, str] | None:
    if ":" not in line:
        return None
    head, value = line.split(":", 1)
    parts = head.split(";")
    params = {}
    for part in parts[1:]:
        if "=" in part:
            key, param_value = part.split("=", 1)
            params[key.upper()] = param_value.strip('"')
    return parts[0].upper(), params, unescape_ical(value)


def parse_ical_datetime(value: str, params: dict) -> tuple[datetime, bool]:
    is_date = params.get("VALUE") == "DATE" or (len(value) == 8 and "T" not in value)
    if is_date:
        return datetime.combine(datetime.strptime(value[:8], "%Y%m%d").date(), time.min,
                                datetime.now().astimezone().tzinfo), True
    utc = value.endswith("Z")
    raw = value[:-1] if utc else value
    fmt = "%Y%m%dT%H%M%S" if len(raw) >= 15 else "%Y%m%dT%H%M"
    parsed = datetime.strptime(raw[:15] if len(raw) >= 15 else raw[:13], fmt)
    if utc:
        return parsed.replace(tzinfo=ZoneInfo("UTC")).astimezone(), False
    tzid = params.get("TZID", "")
    if tzid:
        try:
            return parsed.replace(tzinfo=ZoneInfo(tzid)).astimezone(), False
        except ZoneInfoNotFoundError:
            pass
    return parsed.replace(tzinfo=datetime.now().astimezone().tzinfo), False


def parse_ical(text: str) -> list[dict]:
    events: list[dict] = []
    current: dict | None = None
    for line in unfold_ical(text):
        upper = line.upper()
        if upper == "BEGIN:VEVENT":
            current = {}
        elif upper == "END:VEVENT" and current is not None:
            events.append(current)
            current = None
        elif current is not None:
            parsed = parse_content_line(line)
            if not parsed:
                continue
            key, params, value = parsed
            if key in ("EXDATE", "RDATE"):
                current.setdefault(key, []).extend((part, params) for part in value.split(","))
            elif key not in current:
                current[key] = (value, params)
    return events


def add_months(value: datetime, months: int) -> datetime:
    index = value.year * 12 + value.month - 1 + months
    year, month = divmod(index, 12)
    day = min(value.day, month_calendar.monthrange(year, month + 1)[1])
    return value.replace(year=year, month=month + 1, day=day)


def recurrence_starts(event: dict, window_start: datetime, window_end: datetime) -> list[datetime]:
    start, _ = parse_ical_datetime(*event["DTSTART"])
    rule_raw = event.get("RRULE", ("", {}))[0]
    if not rule_raw:
        return [start] if start < window_end else []
    rule = dict(part.split("=", 1) for part in rule_raw.split(";") if "=" in part)
    freq = rule.get("FREQ", "").upper()
    interval = max(1, int(rule.get("INTERVAL", "1")))
    count = int(rule["COUNT"]) if rule.get("COUNT", "").isdigit() else None
    until = None
    if rule.get("UNTIL"):
        until = parse_ical_datetime(rule["UNTIL"], {})[0]
    bydays = rule.get("BYDAY", "").split(",") if rule.get("BYDAY") else []
    weekdays = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}
    output: list[datetime] = []
    occurrence = 0
    cursor = start
    # Bound expansion: old feeds may begin years ago, but a day agenda needs only
    # nearby instances. The cap also protects the shell from malicious feeds.
    while cursor < window_end and occurrence < 10000:
        candidates = [cursor]
        if freq == "WEEKLY" and bydays:
            week = cursor - timedelta(days=cursor.weekday())
            candidates = [week + timedelta(days=weekdays[token[-2:]]) for token in bydays
                          if token[-2:] in weekdays]
        for candidate in sorted(candidates):
            if candidate < start or (until and candidate > until):
                continue
            occurrence += 1
            if count is not None and occurrence > count:
                return output
            if candidate < window_end:
                output.append(candidate)
        if until and cursor > until:
            break
        if count is not None and occurrence >= count:
            break
        if freq == "DAILY":
            cursor += timedelta(days=interval)
        elif freq == "WEEKLY":
            cursor += timedelta(weeks=interval)
        elif freq == "MONTHLY":
            cursor = add_months(cursor, interval)
        elif freq == "YEARLY":
            cursor = add_months(cursor, 12 * interval)
        else:
            break
    return output


def ical_events(feed: dict, day: date) -> list[dict]:
    zone = datetime.now().astimezone().tzinfo
    window_start = datetime.combine(day, time.min, zone)
    window_end = datetime.combine(day + timedelta(days=1), time.min, zone)
    output = []
    for raw in parse_ical(read_ical_source(feed)):
        if "DTSTART" not in raw or raw.get("STATUS", ("", {}))[0].upper() == "CANCELLED":
            continue
        original_start, all_day = parse_ical_datetime(*raw["DTSTART"])
        if "DTEND" in raw:
            original_end, _ = parse_ical_datetime(*raw["DTEND"])
        else:
            original_end = original_start + (timedelta(days=1) if all_day else timedelta(hours=1))
        duration = original_end - original_start
        excluded = {parse_ical_datetime(value, params)[0] for value, params in raw.get("EXDATE", [])}
        starts = recurrence_starts(raw, window_start, window_end)
        starts.extend(parse_ical_datetime(value, params)[0] for value, params in raw.get("RDATE", []))
        for start in starts:
            end = start + duration
            if start in excluded or end <= window_start or start >= window_end:
                continue
            title = raw.get("SUMMARY", ("(Untitled)", {}))[0] or "(Untitled)"
            description = raw.get("DESCRIPTION", ("", {}))[0]
            location = raw.get("LOCATION", ("", {}))[0]
            url = raw.get("URL", ("", {}))[0]
            synthetic = {
                "id": f"ical:{feed['id']}:{raw.get('UID', (title, {}))[0]}:{start.isoformat()}",
                "title": title, "start": start.isoformat(), "end": end.isoformat(),
                "timeLabel": "All day" if all_day else start.strftime("%-I:%M %p"),
                "allDay": all_day, "isNow": start <= datetime.now().astimezone() < end,
                "accountId": f"ical:{feed['id']}", "accountLabel": feed.get("name", "iCalendar"),
                "calendarId": feed["id"], "calendarLabel": feed.get("name", "iCalendar"),
                "priority": feed.get("priority", "normal"), "color": "",
                "joinUrl": meeting_url({"location": location, "description": description + " " + url}),
                "htmlLink": url if url.startswith("https://") else "", "attendees": [],
                "organizer": {}, "creator": {}, "description": description,
                "location": location, "recurringEventId": raw.get("UID", ("", {}))[0],
                "status": "confirmed", "guestCount": 0,
            }
            output.append(synthetic)
    return output


def request_json(url: str, token: str | None = None, data: dict | None = None) -> dict:
    body = urllib.parse.urlencode(data).encode() if data is not None else None
    headers = {"Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    if body:
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    request = urllib.request.Request(url, body, headers)
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


def client_config() -> dict:
    try:
        raw = json.loads(CLIENT_FILE.read_text())
        return raw.get("installed") or raw["web"]
    except (OSError, KeyError, json.JSONDecodeError) as exc:
        raise SystemExit(f"Invalid or missing OAuth credentials at {CLIENT_FILE}: {exc}")


def accounts() -> list[dict]:
    try:
        return json.loads(ACCOUNTS_FILE.read_text()).get("accounts", [])
    except (OSError, json.JSONDecodeError):
        return []


def save_accounts(items: list[dict]) -> None:
    atomic_json(ACCOUNTS_FILE, {"accounts": items})
    invalidate_cache()


def preferences() -> dict:
    try:
        raw = json.loads(PREFERENCES_FILE.read_text())
        return raw if isinstance(raw, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def save_preferences(value: dict) -> None:
    atomic_json(PREFERENCES_FILE, value)
    invalidate_cache()


def invalidate_cache() -> None:
    if not CACHE_DIR.exists():
        return
    for path in CACHE_DIR.glob("*.json"):
        path.unlink(missing_ok=True)


def cache_path(day: date) -> Path:
    return CACHE_DIR / f"{day.isoformat()}.json"


def read_cached_agenda(day: date) -> dict | None:
    path = cache_path(day)
    try:
        if time_module.time() - path.stat().st_mtime > CACHE_TTL_SECONDS:
            return None
        payload = json.loads(path.read_text())
        return payload if isinstance(payload, dict) else None
    except (OSError, json.JSONDecodeError):
        return None


def write_cached_agenda(day: date, payload: dict) -> None:
    CACHE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    path = cache_path(day)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, ensure_ascii=False) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)


def calendar_enabled(account_id: str, calendar_id: str, prefs: dict | None = None) -> bool:
    prefs = preferences() if prefs is None else prefs
    return prefs.get("calendars", {}).get(account_id, {}).get(calendar_id, True) is not False


def set_calendar_enabled(account_id: str, calendar_id: str, enabled: bool) -> None:
    if account_id.startswith("ical:"):
        update_feed(calendar_id, enabled=enabled)
        return
    prefs = preferences()
    prefs.setdefault("calendars", {}).setdefault(account_id, {})[calendar_id] = enabled
    save_preferences(prefs)


def calendar_priority(account_id: str, calendar_id: str, prefs: dict | None = None) -> str:
    prefs = preferences() if prefs is None else prefs
    value = prefs.get("priorities", {}).get(account_id, {}).get(calendar_id, "normal")
    return value if value in PRIORITIES else "normal"


def set_calendar_priority(account_id: str, calendar_id: str, priority: str) -> None:
    if priority not in PRIORITIES:
        raise ValueError(f"unsupported calendar priority: {priority}")
    if account_id.startswith("ical:"):
        update_feed(calendar_id, priority=priority)
        return
    prefs = preferences()
    prefs.setdefault("priorities", {}).setdefault(account_id, {})[calendar_id] = priority
    save_preferences(prefs)


def set_account_calendars_enabled(account_id: str, calendar_ids: list[str], enabled: bool) -> None:
    if account_id.startswith("ical:"):
        for calendar_id in calendar_ids:
            update_feed(calendar_id, enabled=enabled)
        return
    prefs = preferences()
    account_prefs = prefs.setdefault("calendars", {}).setdefault(account_id, {})
    for calendar_id in calendar_ids:
        account_prefs[calendar_id] = enabled
    save_preferences(prefs)


def update_feed(feed_id: str, **changes: object) -> None:
    items = feeds()
    for item in items:
        if item.get("id") == feed_id:
            item.update(changes)
            save_feeds(items)
            return
    raise ValueError(f"unknown iCalendar source: {feed_id}")


def store_token(account_id: str, token: str) -> None:
    subprocess.run(
        ["secret-tool", "store", "--label", f"OmaScribe Calendar: {account_id}", "application", APP, "account", account_id],
        input=token, text=True, check=True,
    )


def load_token(account_id: str) -> str:
    for application in (APP, LEGACY_KEYRING_APP):
        result = subprocess.run(
            ["secret-tool", "lookup", "application", application, "account", account_id],
            text=True, capture_output=True, check=False,
        )
        token = result.stdout.strip() if result.returncode == 0 else ""
        if token:
            if application == LEGACY_KEYRING_APP:
                store_token(account_id, token)
            return token
    raise RuntimeError("refresh token missing from keyring")


def access_token(account: dict) -> str:
    cfg = client_config()
    response = request_json(cfg["token_uri"], data={
        "client_id": cfg["client_id"],
        "client_secret": cfg.get("client_secret", ""),
        "refresh_token": load_token(account["id"]),
        "grant_type": "refresh_token",
    })
    return response["access_token"]


class OAuthHandler(http.server.BaseHTTPRequestHandler):
    result: dict = {}
    expected_state = ""

    def do_GET(self) -> None:
        params = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
        if params.get("state", [""])[0] != self.expected_state:
            type(self).result = {"error": "OAuth state mismatch"}
            status = 400
        elif "error" in params:
            type(self).result = {"error": params["error"][0]}
            status = 400
        else:
            type(self).result = {"code": params.get("code", [""])[0]}
            status = 200
        message = b"Authorization received. You can close this tab and return to Omarchy."
        self.send_response(status)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(message)))
        self.end_headers()
        self.wfile.write(message)

    def log_message(self, *_: object) -> None:
        pass


def add_account() -> None:
    cfg = client_config()
    verifier = base64.urlsafe_b64encode(secrets.token_bytes(48)).rstrip(b"=").decode()
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(24)
    OAuthHandler.expected_state = state
    OAuthHandler.result = {}
    with http.server.HTTPServer(("127.0.0.1", 0), OAuthHandler) as server:
        redirect = f"http://127.0.0.1:{server.server_port}"
        query = urllib.parse.urlencode({
            "client_id": cfg["client_id"], "redirect_uri": redirect,
            "response_type": "code", "scope": SCOPE, "access_type": "offline",
            "prompt": "consent select_account", "state": state,
            "code_challenge": challenge, "code_challenge_method": "S256",
        })
        webbrowser.open(f"{cfg['auth_uri']}?{query}")
        print("Complete authorization in your browser…", file=sys.stderr)
        server.handle_request()
    if "error" in OAuthHandler.result:
        raise SystemExit(f"Authorization failed: {OAuthHandler.result['error']}")
    tokens = request_json(cfg["token_uri"], data={
        "client_id": cfg["client_id"], "client_secret": cfg.get("client_secret", ""),
        "code": OAuthHandler.result["code"], "code_verifier": verifier,
        "grant_type": "authorization_code", "redirect_uri": redirect,
    })
    profile = request_json("https://www.googleapis.com/oauth2/v2/userinfo", tokens["access_token"])
    account_id = profile["id"]
    store_token(account_id, tokens["refresh_token"])
    items = [item for item in accounts() if item["id"] != account_id]
    items.append({"id": account_id, "email": profile.get("email", account_id), "enabled": True})
    save_accounts(items)
    print(f"Added {profile.get('email', account_id)}")


def api_pages(url: str, token: str) -> list[dict]:
    items: list[dict] = []
    while url:
        response = request_json(url, token)
        items.extend(response.get("items", []))
        page = response.get("nextPageToken")
        url = url + ("&" if "?" in url else "?") + urllib.parse.urlencode({"pageToken": page}) if page else ""
    return items


def google_calendars(token: str) -> list[dict]:
    return api_pages("https://www.googleapis.com/calendar/v3/users/me/calendarList?minAccessRole=reader&showHidden=true", token)


def calendar_events(token: str, day: date, calendars: list[dict]) -> list[dict]:
    zone = datetime.now().astimezone().tzinfo
    start = datetime.combine(day, time.min, zone).isoformat()
    end = datetime.combine(day + timedelta(days=1), time.min, zone).isoformat()
    output: list[dict] = []
    for calendar in calendars:
        params = urllib.parse.urlencode({"timeMin": start, "timeMax": end, "singleEvents": "true", "orderBy": "startTime", "maxResults": 100})
        url = "https://www.googleapis.com/calendar/v3/calendars/" + urllib.parse.quote(calendar["id"], safe="") + "/events?" + params
        for event in api_pages(url, token):
            event["_calendar"] = {
                "id": calendar["id"],
                "label": calendar.get("summaryOverride") or calendar.get("summary", ""),
                "color": calendar.get("backgroundColor", ""),
                "priority": calendar.get("priority", "normal"),
            }
            output.append(event)
    return output


def list_calendars() -> dict:
    prefs = preferences()
    result = {"calendars": [], "errors": []}
    for account in [item for item in accounts() if item.get("enabled", True)]:
        try:
            for calendar in google_calendars(access_token(account)):
                calendar_id = calendar["id"]
                result["calendars"].append({
                    "accountId": account["id"],
                    "accountLabel": account.get("email", account["id"]),
                    "calendarId": calendar_id,
                    "calendarLabel": calendar.get("summaryOverride") or calendar.get("summary") or calendar_id,
                    "primary": calendar.get("primary", False),
                    "enabled": calendar_enabled(account["id"], calendar_id, prefs),
                    "priority": calendar_priority(account["id"], calendar_id, prefs),
                })
        except Exception as exc:
            result["errors"].append({"accountId": account["id"], "message": str(exc)})
    for feed in feeds():
        result["calendars"].append({
            "accountId": f"ical:{feed['id']}", "accountLabel": "iCalendar subscriptions",
            "calendarId": feed["id"], "calendarLabel": feed.get("name", "Calendar"),
            "primary": True, "enabled": feed.get("enabled", True),
            "priority": feed.get("priority", "normal"), "sourceType": "ical",
        })
    result["calendars"].sort(key=lambda item: (item["accountLabel"].lower(), not item["primary"], item["calendarLabel"].lower()))
    return result


def meeting_url(event: dict) -> str:
    for entry in event.get("conferenceData", {}).get("entryPoints", []):
        uri = str(entry.get("uri", ""))
        if entry.get("entryPointType") == "video" and uri.startswith("https://"):
            return uri
    if str(event.get("hangoutLink", "")).startswith("https://"):
        return event["hangoutLink"]
    match = URL_RE.search(" ".join([str(event.get("location", "")), str(event.get("description", ""))]))
    return match.group(0).rstrip(".,);]") if match else ""


def person(raw: dict) -> dict:
    """Normalize a Google attendee/organizer object."""
    if not isinstance(raw, dict):
        return {}
    email = str(raw.get("email", ""))
    out = {
        "email": email,
        "displayName": raw.get("displayName") or (email.split("@")[0] if email else ""),
        "responseStatus": raw.get("responseStatus", "needsAction"),
    }
    for flag in ("organizer", "self", "optional", "resource"):
        if raw.get(flag):
            out[flag] = True
    return out


def attendees(event: dict) -> list:
    return [person(a) for a in (event.get("attendees") or []) if isinstance(a, dict)]


def normalize(event: dict, account: dict, now: datetime) -> dict:
    start_raw, end_raw = event.get("start", {}), event.get("end", {})
    all_day = "date" in start_raw
    if all_day:
        start = datetime.combine(date.fromisoformat(start_raw["date"]), time.min, now.tzinfo)
        end = datetime.combine(date.fromisoformat(end_raw["date"]), time.min, now.tzinfo)
        label = "All day"
    else:
        start = datetime.fromisoformat(start_raw["dateTime"].replace("Z", "+00:00")).astimezone()
        end = datetime.fromisoformat(end_raw["dateTime"].replace("Z", "+00:00")).astimezone()
        label = start.strftime("%-I:%M %p")
    calendar = event.get("_calendar", {})
    return {
        "id": event.get("id", ""), "title": event.get("summary") or "(Untitled)",
        "start": start.isoformat(), "end": end.isoformat(), "timeLabel": label,
        "allDay": all_day, "isNow": start <= now < end,
        "accountId": account["id"], "accountLabel": account.get("email", account["id"]),
        "calendarId": calendar.get("id", ""), "calendarLabel": calendar.get("label", ""),
        "priority": calendar.get("priority", "normal"),
        "color": calendar.get("color", ""), "joinUrl": meeting_url(event),
        "htmlLink": event.get("htmlLink", ""),
        "attendees": attendees(event),
        "organizer": person(event.get("organizer") or {}),
        "creator": person(event.get("creator") or {}),
        "description": event.get("description", ""),
        "location": event.get("location", ""),
        "recurringEventId": event.get("recurringEventId", ""),
        "status": event.get("status", "confirmed"),
        "guestCount": len(event.get("attendees") or []),
    }


def build_agenda(day: date) -> dict:
    now = datetime.now().astimezone()
    result = {"date": day.isoformat(), "generatedAt": now.isoformat(), "accounts": [], "events": [], "errors": []}
    tasks = []
    for account in [item for item in accounts() if item.get("enabled", True)]:
        result["accounts"].append({"id": account["id"], "label": account.get("email", account["id"])})
        try:
            token = access_token(account)
            visible = []
            prefs = preferences()
            for calendar in google_calendars(token):
                if not calendar_enabled(account["id"], calendar["id"], prefs):
                    continue
                calendar = dict(calendar)
                calendar["priority"] = calendar_priority(account["id"], calendar["id"], prefs)
                visible.append(calendar)
            for calendar in visible:
                tasks.append((account, token, calendar))
        except Exception as exc:
            result["errors"].append({"accountId": account["id"], "message": str(exc)})

    for feed in [item for item in feeds() if item.get("enabled", True)]:
        account_id = f"ical:{feed['id']}"
        result["accounts"].append({"id": account_id, "label": feed.get("name", "iCalendar"),
                                   "sourceType": "ical"})
        try:
            result["events"].extend(ical_events(feed, day))
        except Exception as exc:
            result["errors"].append({"accountId": account_id,
                                     "message": f"{feed.get('name', 'iCalendar')}: {exc}"})

    if tasks:
        with ThreadPoolExecutor(max_workers=min(8, len(tasks))) as executor:
            pending = {
                executor.submit(calendar_events, token, day, [calendar]): (account, calendar)
                for account, token, calendar in tasks
            }
            for future in as_completed(pending):
                account, calendar = pending[future]
                try:
                    result["events"].extend(normalize(event, account, now) for event in future.result())
                except Exception as exc:
                    result["errors"].append({
                        "accountId": account["id"],
                        "calendarId": calendar["id"],
                        "message": str(exc),
                    })
    unique = {(event["accountId"], event["calendarId"], event["id"]): event for event in result["events"]}
    result["events"] = sorted(unique.values(), key=lambda item: (not item["allDay"], item["start"], item["title"].lower()))
    apply_overlap_layout(result["events"])
    return result


def agenda(day: date, force: bool = False) -> dict:
    if not force:
        cached = read_cached_agenda(day)
        if cached is not None:
            cached["cacheHit"] = True
            return cached
    result = build_agenda(day)
    result["cacheHit"] = False
    if not result["errors"]:
        write_cached_agenda(day, result)
    return result


def prefetch(center: date, days: int) -> None:
    for offset in range(-days, days + 1):
        if offset == 0:
            continue
        agenda(center + timedelta(days=offset))


def apply_overlap_layout(events: list[dict]) -> None:
    timed = [event for event in events if not event.get("allDay")]
    group: list[dict] = []
    group_end: datetime | None = None

    def finish() -> None:
        if not group:
            return
        column_ends: list[datetime] = []
        for event in group:
            start = datetime.fromisoformat(event["start"])
            end = datetime.fromisoformat(event["end"])
            column = next((index for index, value in enumerate(column_ends) if value <= start), len(column_ends))
            if column == len(column_ends):
                column_ends.append(end)
            else:
                column_ends[column] = end
            event["overlapColumn"] = column
        columns = max(1, len(column_ends))
        for event in group:
            event["overlapColumns"] = columns

    for event in timed:
        start = datetime.fromisoformat(event["start"])
        end = datetime.fromisoformat(event["end"])
        if group and group_end is not None and start >= group_end:
            finish()
            group = []
            group_end = None
        group.append(event)
        group_end = end if group_end is None else max(group_end, end)
    finish()


def main() -> None:
    parser = argparse.ArgumentParser(prog="omascribe-calendar")
    commands = parser.add_subparsers(dest="command", required=True)
    account = commands.add_parser("account")
    account_commands = account.add_subparsers(dest="account_command", required=True)
    account_commands.add_parser("add")
    account_commands.add_parser("list")
    source = commands.add_parser("source")
    source_commands = source.add_subparsers(dest="source_command", required=True)
    source_add = source_commands.add_parser("add")
    source_add.add_argument("source", help="https/webcal URL or local .ics file")
    source_add.add_argument("--name")
    source_commands.add_parser("list")
    source_remove = source_commands.add_parser("remove")
    source_remove.add_argument("id")
    calendar = commands.add_parser("calendar")
    calendar_commands = calendar.add_subparsers(dest="calendar_command", required=True)
    calendar_commands.add_parser("list")
    calendar_set = calendar_commands.add_parser("set")
    calendar_set.add_argument("account_id")
    calendar_set.add_argument("calendar_id")
    calendar_set.add_argument("enabled", choices=("true", "false"))
    calendar_priority_parser = calendar_commands.add_parser("priority")
    calendar_priority_parser.add_argument("account_id")
    calendar_priority_parser.add_argument("calendar_id")
    calendar_priority_parser.add_argument("priority", choices=PRIORITIES)
    calendar_account = calendar_commands.add_parser("set-account")
    calendar_account.add_argument("account_id")
    calendar_account.add_argument("enabled", choices=("true", "false"))
    calendar_account.add_argument("calendar_ids", nargs="+")
    agenda_parser = commands.add_parser("agenda")
    agenda_parser.add_argument("--date", default=date.today().isoformat())
    agenda_parser.add_argument("--json", action="store_true")
    agenda_parser.add_argument("--refresh", action="store_true")
    prefetch_parser = commands.add_parser("prefetch")
    prefetch_parser.add_argument("--date", default=date.today().isoformat())
    prefetch_parser.add_argument("--days", type=int, default=2)
    args = parser.parse_args()
    if args.command == "account" and args.account_command == "add":
        add_account()
    elif args.command == "account":
        print(json.dumps({"accounts": accounts()}, indent=2))
    elif args.command == "source" and args.source_command == "add":
        print(json.dumps(add_feed(args.source, args.name), indent=2))
    elif args.command == "source" and args.source_command == "list":
        public = [{key: value for key, value in item.items() if key != "source"} for item in feeds()]
        print(json.dumps({"sources": public}, indent=2))
    elif args.command == "source":
        remove_feed(args.id)
        print(json.dumps({"removed": args.id}))
    elif args.command == "calendar" and args.calendar_command == "list":
        print(json.dumps(list_calendars(), indent=2))
    elif args.command == "calendar" and args.calendar_command == "set":
        set_calendar_enabled(args.account_id, args.calendar_id, args.enabled == "true")
        print(json.dumps({"accountId": args.account_id, "calendarId": args.calendar_id, "enabled": args.enabled == "true"}))
    elif args.command == "calendar" and args.calendar_command == "priority":
        set_calendar_priority(args.account_id, args.calendar_id, args.priority)
        print(json.dumps({"accountId": args.account_id, "calendarId": args.calendar_id, "priority": args.priority}))
    elif args.command == "calendar":
        enabled = args.enabled == "true"
        set_account_calendars_enabled(args.account_id, args.calendar_ids, enabled)
        print(json.dumps({"accountId": args.account_id, "calendarIds": args.calendar_ids, "enabled": enabled}))
    elif args.command == "agenda":
        print(json.dumps(agenda(date.fromisoformat(args.date), force=args.refresh), indent=2))
    elif args.command == "prefetch":
        prefetch(date.fromisoformat(args.date), max(0, min(args.days, 7)))


if __name__ == "__main__":
    main()
